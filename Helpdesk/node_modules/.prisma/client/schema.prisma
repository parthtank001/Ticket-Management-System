datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  AGENT
}

enum Category {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_STUDENT
  RESOLVED
  CLOSED
}

enum SenderType {
  STUDENT
  AGENT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(AGENT)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  tickets       Ticket[]  @relation("AssignedAgent")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Ticket {
  id              String          @id @default(cuid())
  ticketNumber    Int             @unique @default(autoincrement())
  subject         String
  studentEmail    String
  studentName     String?
  category        Category        @default(GENERAL_QUESTION)
  priority        Priority        @default(MEDIUM)
  status          TicketStatus    @default(NEW)
  summary         String?
  aiDraftResponse String?
  assignedAgentId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assignedAgent   User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages        TicketMessage[]
}

model TicketMessage {
  id             String     @id @default(cuid())
  ticketId       String
  senderType     SenderType
  senderEmail    String
  body           String
  isInternalNote Boolean    @default(false)
  messageId      String?    @unique
  inReplyTo      String?
  createdAt      DateTime   @default(now())
  ticket         Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseDocument {
  id        String   @id @default(cuid())
  title     String
  category  Category
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
