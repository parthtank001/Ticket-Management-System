# Database Connection String for PostgreSQL helpdesk database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk?schema=public"

# Server & API Base URL Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL="http://localhost:5000"
VITE_API_URL="http://localhost:5000"
PLAYWRIGHT_BASE_URL="http://localhost:5173"

# Webhook & Inbound Email Configuration
WEBHOOK_SECRET="your-webhook-secret-token"
SUPPORT_EMAIL="support@example.com"

# AI API Key (OpenAI / GPT-5 Nano)
OPENAI_API_KEY="your-openai-api-key"

# Better Auth Configuration
BETTER_AUTH_SECRET="super-secret-better-auth-key-123456789"
BETTER_AUTH_URL="http://localhost:5000"
TRUSTED_ORIGIN="http://localhost:5173"

# Admin & Agent Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="password123"