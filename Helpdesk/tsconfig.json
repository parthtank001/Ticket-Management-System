{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@helpdesk/core": ["./core/src/index.ts"],
      "@helpdesk/core/*": ["./core/src/*"]
    }
  },
  "include": ["server/**/*", "prisma/**/*", "scripts/**/*", "playwright.config.ts", "e2e/**/*", "core/**/*"]
}
