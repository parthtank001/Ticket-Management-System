{
  "name": "ai-ticket-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "ts-node server/index.ts",
    "build": "npm --prefix client run build",
    "start": "ts-node server/index.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:tickets": "ts-node scripts/seed-100-tickets.ts",
    "create-user": "ts-node scripts/create-user.ts",
    "db:test:setup": "ts-node scripts/setup-test-db.ts",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "test:client": "npm --prefix client run test",
    "test:client:watch": "npm --prefix client run test:watch",
    "test:client:ui": "npm --prefix client run test:ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai": "^4.0.71",
    "@google/genai": "^0.2.0",
    "@helpdesk/core": "file:./core",
    "@prisma/client": "^5.22.0",
    "ai": "^7.0.107",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.6",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
