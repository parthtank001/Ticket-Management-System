# Database Connection String for PostgreSQL helpdesk database
DATABASE_URL="postgresql://postgres:parth@localhost:5432/helpdesk?schema=public"


# Server Port Configuration
PORT=5000
NODE_ENV=development

# Gemini AI API Key (Set your Google Gemini API Key here)
GEMINI_API_KEY=""

# SendGrid / Mailgun API Key & Webhook Secret
# Better Auth Configuration
BETTER_AUTH_SECRET="super-secret-better-auth-key-123456789"
BETTER_AUTH_URL="http://localhost:5000"

# Admin & Agent Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="password123"

